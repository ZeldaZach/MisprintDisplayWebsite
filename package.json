{
  "name": "magic_misprint_display",
  "homepage": "https://zachhalpern.com/misprints",
  "version": "0.2.0",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.2.5",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^18.11.18",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.10",
    "focus-trap-react": "^11.0.4",
    "lodash.debounce": "^4.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "sharp": "^0.34.5",
    "ts-transformer-keys": "^0.4.4",
    "typescript": "^4.9.4",
    "web-vitals": "^3.1.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "npm run downloadData && npm run cacheImages && npm run generateThumbnails && npm run build:site",
    "build:site": "react-scripts build",
    "downloadData": "curl -s -L -o src/data/data.json https://opensheet.elk.sh/1UVH1MARe1l6V3y_2hTAKZep7KApFCWiYMe9GN_Uc9OU/Collection",
    "cacheImages": "python3 src/downloadDropboxImages.py",
    "generateThumbnails": "node src/generateThumbnails.js",
    "test": "vitest",
    "eject": "react-scripts eject",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^2.1.9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "vitest": "^2.1.9"
  }
}
